# Token của Bot Discord (Lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID (Application ID) của Bot Discord để đăng ký Slash Commands (/play, /skip, /webroom...)
DISCORD_CLIENT_ID=your_discord_client_id_here

# Link API trang web LoveTunes của Thịnh & Thảo Như
LOVETUNES_API_URL=https://thinhyeuthaonhu.onrender.com

# Mã phòng mặc định trên web để đồng bộ
DEFAULT_ROOM_ID=THINH-NHU
