# Token của Bot Discord (Lấy tại https://discord.com/developers/applications -> mục Bot -> Reset Token)
DISCORD_TOKEN=

# Client ID (Application ID) của Bot Discord (Không bắt buộc - Bot tự nhận diện được từ Token)
DISCORD_CLIENT_ID=

# Link API trang web LoveTunes đã nâng cấp trên Render
LOVETUNES_API_URL=https://thinhyeuthaonhu.onrender.com

# Mã phòng mặc định để đồng bộ nhạc giữa Discord & Web của Thịnh và Thảo Như
DEFAULT_ROOM_ID=THINH-NHU
